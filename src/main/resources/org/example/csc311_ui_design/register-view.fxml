<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F7F5EF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.csc311_ui_design.RegisterController">
   <children>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#0b3d2e" height="600.0" stroke="WHITE" strokeType="INSIDE" width="330.0" />
      <Label layoutX="28.0" layoutY="161.0" text="FSC" textFill="WHITE">
         <font>
            <Font name="Futura Bold" size="34.0" />
         </font>
      </Label>
      <Label layoutX="28.0" layoutY="218.0" text="Join the FSC Community" textFill="WHITE">
         <font>
            <Font name="Avenir Next Demi Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="28.0" layoutY="266.0" text="Create your account and get started. " textFill="#b8e0d2">
         <font>
            <Font name="Avenir Roman" size="14.0" />
         </font>
      </Label>
      <Label layoutX="410.0" layoutY="95.0" styleClass="page-title" text="Create Account" textFill="#0b3d2e">
         <font>
            <Font name="Avenir Next Demi Bold" size="28.0" />
         </font>
      </Label>
      <Label layoutX="410.0" layoutY="155.0" text="Full Name" textFill="#333333">
         <font>
            <Font name="Avenir Next Demi Bold" size="14.0" />
         </font>
      </Label>
      <TextField layoutX="410.0" layoutY="180.0" prefHeight="40.0" prefWidth="380.0" promptText="Enter your full name">
         <font>
            <Font name="Avenir Roman" size="14.0" />
         </font>
      </TextField>
      <Label layoutX="410.0" layoutY="235.0" text="Email Address " textFill="#333333">
         <font>
            <Font name="Avenir Next Demi Bold" size="14.0" />
         </font>
      </Label>
      <TextField layoutX="410.0" layoutY="260.0" prefHeight="40.0" prefWidth="380.0" promptText="Enter your email">
         <font>
            <Font name="Avenir Roman" size="14.0" />
         </font>
      </TextField>
      <Label layoutX="410.0" layoutY="315.0" text="Password" textFill="#333333">
         <font>
            <Font name="Avenir Next Demi Bold" size="14.0" />
         </font>
      </Label>
      <TextField layoutX="410.0" layoutY="340.0" prefHeight="40.0" prefWidth="380.0" promptText="Enter your password">
         <font>
            <Font name="Avenir Roman" size="14.0" />
         </font>
      </TextField>
      <Label layoutX="410.0" layoutY="395.0" text="Confirm Password" textFill="#333333">
         <font>
            <Font name="Avenir Next Demi Bold" size="14.0" />
         </font>
      </Label>
      <TextField layoutX="410.0" layoutY="420.0" prefHeight="40.0" prefWidth="380.0" promptText="Re-enter your password">
         <font>
            <Font name="Avenir Roman" size="14.0" />
         </font>
      </TextField>
      <Button layoutX="410.0" layoutY="485.0" mnemonicParsing="false" onAction="#goToLogin" prefHeight="44.0" prefWidth="380.0" style="-fx-background-color: #0B3D2E; -fx-text-fill: white; -fx-background-radius: 8;" text="CREATE ACCOUNT">
         <font>
            <Font name="Avenir Next Demi Bold" size="14.0" />
         </font>
      </Button>
      <Label layoutX="525.0" layoutY="543.0" text="Already have an account?" textFill="#666666">
         <font>
            <Font name="Avenir Roman" size="13.0" />
         </font>
      </Label>
      <Label layoutX="590.0" layoutY="567.0" onMouseClicked="#goToLogin" text="Sign In" textFill="#0b3d2e">
         <font>
            <Font name="Avenir Next Demi Bold" size="13.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
